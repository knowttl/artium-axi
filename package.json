{
  "name": "artium-axi",
  "version": "0.0.45",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "artium-axi-server": "bin/artium-axi-server"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "start": "node dist/src/server/main.js",
    "prepare": "pnpm --dir tools install --frozen-lockfile",
    "build": "node scripts/build.mjs",
    "build:npm": "node scripts/build-npm.mjs",
    "test:containers": "node scripts/container-checks.mjs",
    "test:browser": "pnpm build && node --test test/browser/*.mjs test/browser/*.ts",
    "test:axi": "node scripts/axi-check.ts",
    "test:walking-skeleton": "pnpm build && node scripts/walking-skeleton.mjs",
    "test": "node scripts/upstream-inventory.mjs && node scripts/mg-headless-schema.ts && vitest run",
    "test:gate": "node scripts/test-gate.ts",
    "test:mg-headless": "node scripts/mg-headless-check.mjs",
    "test:fake-services": "pnpm build && node scripts/fake-services.mjs",
    "test:build-image": "node scripts/build-fake-service-image.mjs",
    "test:runner-container": "pnpm build && node scripts/runner-container-check.mjs",
    "test:security": "vitest run --testNamePattern security --passWithNoTests",
    "lint": "tsc --noEmit && tsc -p tsconfig.scripts.json && tsc -p tsconfig.axi-check.json && tsc -p tsconfig.client.json && node --check scripts/axi-check.ts && node scripts/tls-policy.ts",
    "errors:generate": "node scripts/errors-reference.ts --write",
    "offered:generate": "node scripts/offered-commands.mjs",
    "pin:freshness": "node scripts/pin-freshness.mjs",
    "check": "node scripts/errors-reference.ts && pnpm lint && pnpm test && pnpm build && pnpm test:axi",
    "hygiene:check": "node scripts/hygiene-check.ts"
  },
  "devDependencies": {
    "@actions/expressions": "0.3.61",
    "@types/better-sqlite3": "9.6.0",
    "@types/css-tree": "3.2.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "1.15.6",
    "css-tree": "3.2.1",
    "esbuild": "0.28.2",
    "parse5": "8.0.0",
    "postcss": "8.5.29",
    "typescript": "5.9.3",
    "vitest": "4.1.0",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "better-sqlite3",
      "esbuild"
    ]
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.16",
    "@astryxdesign/theme-neutral": "0.7.16",
    "@azure/msal-node": "7.0.1",
    "@fastify/cookie": "^11.1.3",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/formbody": "^8.0.2",
    "@stylexjs/stylex": "0.19.2",
    "@toon-format/toon": "2.3.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.3",
    "fastify": "^5.12.5",
    "openid-client": "6.8.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.5"
  }
}
