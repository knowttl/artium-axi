{
  "name": "artium-axi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "prepare": "pnpm --dir tools install --frozen-lockfile",
    "build": "tsc",
    "test": "node scripts/upstream-inventory.mjs && vitest run",
    "test:fake-services": "node scripts/fake-services.mjs",
    "test:build-image": "node scripts/build-fake-service-image.mjs",
    "test:security": "vitest run --testNamePattern security --passWithNoTests",
    "lint": "tsc --noEmit",
    "check": "pnpm lint && pnpm test && pnpm build",
    "hygiene:check": "node scripts/hygiene-check.mjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["argon2", "better-sqlite3", "esbuild"]
  },
  "dependencies": {
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.3"
  }
}
