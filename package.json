{
  "name": "artium-axi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:security": "vitest run --testNamePattern security --passWithNoTests",
    "lint": "tsc --noEmit",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
