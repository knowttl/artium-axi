  "credentialSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/knowttl/technitium-axi/axi-credential.schema.json",
    "title": "Technitium credential profile",
    "description": "AXI Credential Standard v2 profile. Secret values must be references.",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "origin",
      "auth",
      "tokenKind"
    ],
    "properties": {
      "origin": {
        "type": "string",
        "pattern": "^https://(?:\\[[0-9A-Fa-f:]+\\]|[A-Za-z0-9.-]+)(?::[0-9]{1,5})?$"
      },
      "auth": {
        "const": "token",
        "type": "string"
      },
      "tokenKind": {
        "type": "string",
        "enum": [
          "api",
          "session",
          "single-use"
        ]
      },
      "token": {
        "$ref": "#/definitions/secretRef",
        "x-secret": true,
        "default": {
          "env": "TECHNITIUM_AXI_TOKEN"
        }
      },
      "username": {
        "type": "string",
        "minLength": 1
      },
      "caFile": {
        "type": "string",
        "minLength": 1
      },
      "tlsServerName": {
        "type": "string",
        "pattern": "^[A-Za-z0-9.-]+$"
      },
      "writes": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "allowWrites",
          "operations"
        ],
        "default": {
          "allowWrites": false,
          "operations": []
        },
        "properties": {
          "allowWrites": {
            "const": false,
            "type": "boolean"
          },
          "operations": {
            "type": "array",
            "maxItems": 0,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "definitions": {
      "secretRef": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "env"
            ],
            "properties": {
              "env": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file"
            ],
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^(?:/|[A-Za-z]:[\\\\/]).+"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stored"
            ],
            "properties": {
              "stored": {
                "const": true,
                "type": "boolean"
              }
            }
          }
        ]
      }
    }
  },
