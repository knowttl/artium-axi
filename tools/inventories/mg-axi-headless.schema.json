{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "@knowttl/mg-axi 0.1.4 headless application profile",
  "description": "Local projection of dist/profiles.js; generated by scripts/mg-headless-schema.mjs. Live consent unverified.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mode": {
      "const": "application"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "clientId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "cloud": {
      "const": "commercial"
    },
    "preview": {
      "type": "boolean"
    },
    "allowDeviceCode": {
      "const": false
    },
    "enabledPacks": {
      "type": "array",
      "items": {
        "const": "entra"
      },
      "uniqueItems": true
    },
    "sensitiveAreas": {
      "type": "array",
      "maxItems": 0
    },
    "credentialRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "const": "client-secret"
            },
            "key": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "secretEnv": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "required": [
            "provider",
            "key",
            "secretEnv"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "const": "client-secret"
            },
            "key": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "secretFile": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "required": [
            "provider",
            "key",
            "secretFile"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "const": "certificate"
            },
            "key": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "thumbprint": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{40}$"
            },
            "keyEnv": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "required": [
            "provider",
            "key",
            "thumbprint",
            "keyEnv"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "const": "certificate"
            },
            "key": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "thumbprint": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{40}$"
            },
            "keyFile": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "required": [
            "provider",
            "key",
            "thumbprint",
            "keyFile"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "const": "certificate"
            },
            "key": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "thumbprint": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{40}$"
            }
          },
          "required": [
            "provider",
            "key",
            "thumbprint"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "const": "federated"
            },
            "key": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "tokenFileEnv": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "required": [
            "provider",
            "key"
          ]
        }
      ]
    },
    "writes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowWrites": {
          "type": "boolean"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "required": [
        "allowWrites",
        "operations"
      ]
    }
  },
  "required": [
    "mode",
    "tenantId",
    "clientId",
    "cloud",
    "preview",
    "allowDeviceCode",
    "enabledPacks",
    "sensitiveAreas",
    "credentialRef"
  ]
}
