    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "urn:kubernetes-axi:credential-profile",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "origin",
      "auth",
      "certificateAuthority"
    ],
    "properties": {
      "origin": {
        "type": "string",
        "minLength": 1
      },
      "auth": {
        "enum": [
          "token",
          "certificate"
        ]
      },
      "namespace": {
        "type": "string",
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
        "maxLength": 63
      },
      "certificateAuthority": {
        "type": "string",
        "minLength": 1
      },
      "token": {
        "$ref": "#/definitions/secretRef",
        "x-secret": true
      },
      "clientCertificate": {
        "type": "string",
        "minLength": 1
      },
      "privateKey": {
        "$ref": "#/definitions/secretRef",
        "x-secret": true
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "auth": {
              "const": "token"
            }
          }
        },
        "then": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "privateKey"
                ]
              },
              {
                "required": [
                  "clientCertificate"
                ]
              }
            ]
          }
        },
        "else": {
          "required": [
            "clientCertificate"
          ],
          "not": {
            "required": [
              "token"
            ]
          }
        }
      }
    ],
    "definitions": {
      "secretRef": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "env"
            ],
            "properties": {
              "env": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    }
