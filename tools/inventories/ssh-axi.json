        }
      }
    ],
    "properties": {
      "address": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253,
        "pattern": "^[A-Za-z0-9.:_-]+$",
        "description": "Approved SSH hostname or IP address; every resolved address must be allowed."
      },
      "port": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535,
        "description": "Approved SSH TCP port."
      },
      "username": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.-]+$",
        "description": "Ordinary SSH account selected by the host binding."
      },
      "approvedHostKeys": {
        "type": "array",
        "minItems": 1,
        "maxItems": 2,
        "uniqueItems": true,
        "description": "Independently verified server public keys, each as algorithm plus base64 key; at most two overlap during rotation.",
        "items": {
