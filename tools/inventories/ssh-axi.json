      },
      "connection set": {
        "arguments": 1,
        "description": "Change a hosted connection idle timeout",
        "flags": {
          "idle-timeout": "string"
        }
      },
      "connection close": {
        "arguments": 1,
        "description": "Close a caller-owned hosted connection",
        "flags": {
          "confirm": "boolean"
        }
      },
      "execution list": {
        "arguments": 0,
        "description": "List caller-owned executions"
      },
      "execution show": {
        "arguments": 1,
        "description": "Recover an execution without replay",
        "flags": {
          "request-key": "string",
          "full": "boolean"
        }
      },
      "execution cancel": {
        "arguments": 1,
        "description": "Cancel one caller-owned execution",
        "flags": {
          "confirm": "boolean"
        }
      }
    },
    "type": "object",
    "additionalProperties": false,
    "required": [
      "address",
      "port",
      "username",
      "approvedHostKeys",
      "allowedAddresses"
