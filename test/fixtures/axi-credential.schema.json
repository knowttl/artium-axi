{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Synthetic credential profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "tenantId", "clientId", "auth"],
  "properties": {
    "mode": { "const": "application", "type": "string" },
    "tenantId": { "type": "string", "format": "uuid" },
    "clientId": { "type": "string", "format": "uuid" },
    "auth": { "enum": ["client-secret", "certificate", "federated"] },
    "clientSecret": { "$ref": "#/$defs/secret", "x-secret": true },
    "privateKey": { "$ref": "#/$defs/secret", "x-secret": true },
    "token": { "$ref": "#/$defs/secret", "x-secret": true },
    "thumbprintSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "writes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowWrites", "operations"],
      "properties": {
        "allowWrites": { "type": "boolean" },
        "operations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "oneOf": [
    { "properties": { "auth": { "const": "client-secret" } }, "required": ["clientSecret"], "not": { "anyOf": [{ "required": ["privateKey"] }, { "required": ["thumbprintSha256"] }, { "required": ["token"] }] } },
    { "properties": { "auth": { "const": "certificate" } }, "required": ["privateKey", "thumbprintSha256"], "not": { "anyOf": [{ "required": ["clientSecret"] }, { "required": ["token"] }] } },
    { "properties": { "auth": { "const": "federated" } }, "required": ["token"], "not": { "anyOf": [{ "required": ["clientSecret"] }, { "required": ["privateKey"] }, { "required": ["thumbprintSha256"] }] } }
  ],
  "$defs": {
    "secret": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["env"], "properties": { "env": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } } },
        { "type": "object", "additionalProperties": false, "required": ["file"], "properties": { "file": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["stored"], "properties": { "stored": { "const": true } } }
      ]
    }
  }
}
