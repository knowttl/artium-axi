{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["auth"],
  "properties": {
    "auth": { "enum": ["az", "token"] },
    "tenantId": { "type": "string", "format": "uuid" },
    "subscriptions": { "type": "array", "items": { "type": "string" } },
    "managementGroup": { "type": "string" },
    "workspaces": { "type": "object", "additionalProperties": { "type": "string" } },
    "description": { "type": "string" },
    "allowWrites": { "type": "boolean" },
    "armToken": { "$ref": "#/$defs/secret" },
    "logsToken": { "$ref": "#/$defs/secret" },
    "graphToken": { "$ref": "#/$defs/secret" },
    "storageToken": { "$ref": "#/$defs/secret" },
    "vaultToken": { "$ref": "#/$defs/secret" },
    "registryToken": { "$ref": "#/$defs/secret" }
  },
  "$defs": {
    "secret": {
      "x-secret": true,
      "type": "object",
      "additionalProperties": false,
      "required": ["env"],
      "properties": { "env": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } }
    }
  }
}
